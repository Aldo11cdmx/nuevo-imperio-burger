{
  "appId": "com.nuevoimperio.burger",
  "appName": "Nuevo Imperio Burger",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 3000,
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "KeepAwake": {
      "keepAwake": true
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "visible": false,
      "backgroundColor": "#0B0A0C"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}
